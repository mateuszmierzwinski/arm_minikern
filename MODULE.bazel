module(
    name = "minikern",
    version = "1.0",
)

# The cc_toolchain plumbing the kernel's own freestanding ARMv7-A toolchain is
# built on (toolchain/cc_toolchain_config.bzl), and shell rules for the QEMU
# tests — Bazel 9 removed the native sh_test.
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_shell", version = "0.6.1")

# pkg_tar builds the ustar archive the kernel mounts as its root filesystem.
bazel_dep(name = "rules_pkg", version = "1.2.0")

# The Go side: the netboot server (a host binary) and the userland programs
# (linux/arm, pure static). Both are standard library only, so there are no
# external Go modules to resolve and gazelle is not needed.
bazel_dep(name = "rules_go", version = "0.59.0", repo_name = "io_bazel_rules_go")

# A downloaded SDK rather than the host's, so every machine builds the same Go.
go_sdk = use_extension("@io_bazel_rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.26.8")
